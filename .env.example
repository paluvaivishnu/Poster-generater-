# ============================================
# BrandForge AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/brandforge

# --- Gemini AI (Optional) ---
# If not set, the app uses local deterministic content generation.
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Server ---
PORT=3001
